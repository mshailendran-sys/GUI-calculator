
from tkinter import Button, Entry,Frame, Label, StringVar,Tk

# Create main root window
root = Tk()
root.title("Calculator")

# Create frame f2
f2 = Frame(root)
f2.pack()

# ---------------Calculator------------------
text_Input = StringVar()
operator = ""

txtdisplay = Entry(
    f2,
    font=("arial", 20, "bold"),
    textvariable=text_Input,
    bd=5,
    insertwidth=7,
    bg="white",
    justify="right",
)
txtdisplay.grid(row=0, column=0, columnspan=4)


def btnclick(numbers):
    global operator
    operator = operator + str(numbers)
    text_Input.set(operator)


def clrdisplay():
    global operator
    operator = ""
    text_Input.set("")


def eqals():
    global operator
    try:
        sumup = str(eval(operator))
        text_Input.set(sumup)
        operator = sumup  # Keep the result for further operations
    except Exception:
        text_Input.set("Error")
        operator = ""


